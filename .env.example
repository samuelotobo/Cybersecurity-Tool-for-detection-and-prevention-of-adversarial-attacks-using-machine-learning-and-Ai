# Security Monitor - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# ── AI Analysis ───────────────────────────────────────────────────────────────

# Groq API key (primary email phishing analyser - free tier available)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API key (fallback email phishing analyser)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Threat Intelligence ───────────────────────────────────────────────────────

# AbuseIPDB API key (free tier: 1000 checks/day)
# Get your key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# ── Network Configuration ─────────────────────────────────────────────────────

# Your router/gateway IP for ARP gateway-hijack detection (CRITICAL severity)
# Leave blank to disable gateway-specific alerts
GATEWAY_IP=192.168.1.1

# ── File Integrity Monitoring ─────────────────────────────────────────────────

# Comma-separated directories to watch for file changes
# Default: the detectors/ subdirectory of the app
# Examples:
#   FIM_WATCH_DIRS=C:\Windows\System32,C:\Users\Public\Documents
#   FIM_WATCH_DIRS=/etc,/usr/bin
FIM_WATCH_DIRS=

# ── DDoS Detection Tuning ─────────────────────────────────────────────────────

# ML confidence threshold override (0-100).
# 0 = use the F1-optimal threshold saved in the model file (recommended)
ATTACK_CONFIDENCE_THRESHOLD=0

# Minimum packets in a flow before classifying it
FLOW_MIN_PACKETS=5

# Flow inactivity timeout in seconds
FLOW_TIMEOUT_S=10.0

# ── Web Dashboard (optional) ──────────────────────────────────────────────────

PORT=5000
DEBUG=false
